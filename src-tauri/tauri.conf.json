{
  "$schema": "https://tauri.app",
  "productName": "Candle",
  "version": "0.1.0",
  "identifier": "com.jzadl.candle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Candle",
        "width": 1000,
        "height": 750,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/candle-backend"
    ]
  },
  "plugins": {
    "opener": {},
    "shell": {
      "open": true
    }
  }
}

